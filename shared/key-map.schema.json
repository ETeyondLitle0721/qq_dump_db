{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qq-dump-db:key-map:1",
  "title": "QQ Dump DB Key Map",
  "description": "Version 1 key map. Contains sensitive database decryption keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_map", "_generated"],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Major output schema version."
    },
    "key_map": {
      "type": "object",
      "minProperties": 1,
      "description": "Mapping from 16-byte database salt (lowercase hex) to 32-byte encryption key (lowercase hex).",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "_generated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Generation time in UTC, RFC 3339 form with Z suffix."
    }
  }
}
